{
  "$schema": "https://tauri.app/v1/schema.json",
  "package": { "productName": "PlayBack", "version": "0.1.0" },
  "build": {
    "beforeDevCommand": "pnpm --dir ./desktop-ui dev",
    "devPath": "http://localhost:5174",
    "beforeBuildCommand": "pnpm --dir ./desktop-ui build",
    "distDir": "../desktop-ui/dist"
  },
  "tauri": {
    "allowlist": {
      "dialog": { "open": true }
    },
    "bundle": {
      "active": true,
      "identifier": "com.avplayback.app",
      "icon": [
        "icons/32x32.png",
        "icons/128x128.png",
        "icons/128x128@2x.png",
        "icons/icon.icns",
        "icons/icon.ico"
      ]
    },
    "windows": [
      {
        "label": "control",
        "title": "PlayBack — Control",
        "width": 1400,
        "height": 1000,
        "minWidth": 1080,
        "minHeight": 800,
        "maximized": true,
        "resizable": true,
        "fileDropEnabled": true
      }
    ]
  }
}
